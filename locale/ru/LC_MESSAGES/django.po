msgstr "когда кто-то отправляет %(quoted)s"

#: apps/flows/triggers/phrasing.py:115
#, python-format
msgid "when someone comments %(quoted)s"
msgstr "когда кто-то комментирует %(quoted)s"

#: apps/flows/triggers/phrasing.py:143
msgid "No trigger yet, so it will not run until you add one"
msgstr ""
"Пока нет триггера, поэтому сценарий не запустится, пока вы его не добавите"

#: apps/flows/triggers/phrasing.py:147
#, python-format
msgid "%(first)s, or %(second)s"
msgstr "%(first)s, или %(second)s"

