#: templates/api/webhook_secret.html:19
#, python-format
msgid ""
"Deliveries to <code>%(webhook_url)s</code> carry <code>X-BrightBean-"
"Signature</code>, an HMAC-SHA256 over the timestamp and the raw body keyed "
"on this secret. The <a href=\"%(api_docs_url)s\">API reference</a> has a "
"verification snippet you can paste into your receiver."
msgstr ""
"Доставки на <code>%(webhook_url)s</code> несут заголовок <code>X-BrightBean-"
