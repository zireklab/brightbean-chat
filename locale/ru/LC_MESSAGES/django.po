#: apps/flows/triggers/registry.py:120
#: templates/flows/triggers/_form_keyword.html:32
#: templates/inbox/_rule_form.html:72 templates/inbox/_rule_form.html:84
msgid "Keyword"
msgstr "Ключевое слово"

#: apps/flows/triggers/registry.py:121
msgid "Runs when an incoming message matches one of these words."
msgstr "Срабатывает, когда входящее сообщение совпадает с одним из этих слов."

#: apps/flows/triggers/registry.py:129
msgid "Comment"
msgstr "Комментарий"

#: apps/flows/triggers/registry.py:130
msgid "Runs when someone comments on a post, and replies to them privately."
msgstr ""
"Срабатывает, когда кто-то комментирует пост, и отвечает ему в личных "
"сообщениях."

#: apps/flows/triggers/registry.py:147
msgid "Story mention"
msgstr "Упоминание в истории"

#: apps/flows/triggers/registry.py:148
msgid "Runs when someone mentions this account in their story."
msgstr "Срабатывает, когда кто-то упоминает этот аккаунт в своей истории."

#: apps/flows/triggers/registry.py:155
msgid "Story reply"
msgstr "Ответ на историю"

#: apps/flows/triggers/registry.py:156
msgid "Runs when someone replies to one of this account's stories."
msgstr "Срабатывает, когда кто-то отвечает на одну из историй этого аккаунта."

#: apps/flows/triggers/registry.py:164
msgid "New follower"
msgstr "Новый подписчик"

#: apps/flows/triggers/registry.py:165
msgid "Runs when someone follows this account."
msgstr "Срабатывает, когда кто-то подписывается на этот аккаунт."

#: apps/flows/triggers/registry.py:168
msgid ""
"Instagram does not tell apps about new followers yet, so this trigger will "
"not run. It is here so it starts working on its own if Instagram opens that "
"up."
msgstr ""
"Instagram пока не сообщает приложениям о новых подписчиках, поэтому этот "
"триггер не сработает. Он здесь на случай, если Instagram откроет эту "
"возможность — тогда он заработает сам собой."

#: apps/flows/triggers/registry.py:177
msgid "Link or QR code"
msgstr "Ссылка или QR-код"

#: apps/flows/triggers/registry.py:178
msgid ""
"Runs when someone arrives through a link or QR code carrying this reference."
msgstr ""
"Срабатывает, когда кто-то приходит по ссылке или QR-коду с этой меткой."

#: apps/flows/triggers/registry.py:186
msgid "Nothing else matched"
msgstr "Ничего другое не подошло"

#: apps/flows/triggers/registry.py:187
msgid "Runs when nothing else matched. At most once per contact per day."
msgstr ""
"Срабатывает, когда ничего другое не подошло. Не чаще раза в день на контакт."

#: apps/flows/triggers/registry.py:195
msgid "Welcome"
msgstr "Приветствие"

#: apps/flows/triggers/registry.py:196
msgid "Runs the first time someone opens a conversation."
msgstr "Срабатывает, когда кто-то впервые открывает диалог."

#: apps/flows/triggers/registry.py:203
msgid "Something happens here"
msgstr "Здесь что-то происходит"

#: apps/flows/triggers/registry.py:204
msgid ""
"Runs when something happens to a contact — a tag added, a field changed."
msgstr ""
"Срабатывает, когда с контактом что-то происходит — добавлен тег, изменено "
"поле."

#: apps/flows/triggers/registry.py:212
msgid "Another system"
msgstr "Другая система"

#: apps/flows/triggers/registry.py:213
msgid "Runs only when the API asks for it."
msgstr "Срабатывает только по запросу через API."

