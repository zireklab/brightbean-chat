#: apps/channels/views_email.py:354
msgid "Too many test emails for this channel just now. Try again shortly."
msgstr ""
"Азыр бул канал үчүн өтө көп сыноо каты жөнөтүлдү. Бир аздан кийин кайра "
"аракет кылыңыз."

#: apps/channels/views_email.py:359
msgid "This connection has no from-address stored."
msgstr "Бул туташуу үчүн жөнөтүүчүнүн дареги сакталган эмес."

#: apps/channels/views_email.py:376
#, python-format
msgid "Sent a test email to %(recipient)s."
msgstr "Сыноо каты %(recipient)s дарегине жөнөтүлдү."

#: apps/channels/views_instagram.py:67
