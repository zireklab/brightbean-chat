msgstr "{contact_name} үчүн аткаруу «{node_label}» жеринде токтоду: {error}"

#: apps/notifications/events.py:242
#, python-brace-format
msgid "{channel_name} needs reconnecting"
msgstr "{channel_name} каналын кайра туташтыруу керек"

#: apps/notifications/events.py:244
#, python-brace-format
msgid ""
"{platform_label} stopped accepting the stored credentials. Nothing will send"
" or receive on this channel until it is reconnected."
msgstr ""
"{platform_label} сакталган каттоо маалыматтарын кабыл алууну токтотту. Кайра"
" туташтырылганга чейин бул канал аркылуу эч нерсе жөнөтүлбөйт же кабыл "
"алынбайт."

#: apps/notifications/events.py:259
msgid "Webhook disabled after repeated failures"
msgstr "Вебхук кайталанган каталардан кийин өчүрүлдү"

#: apps/notifications/events.py:261
#, python-brace-format
msgid ""
"{url} failed {failure_count} times in a row and has been switched off. Re-"
"enable it once the endpoint is healthy again."
msgstr ""
"{url} катары менен {failure_count} жолу катага учурап, өчүрүлдү. Эндпоинт "
"кайра иштей баштаганда аны кайра күйгүзүңүз."

