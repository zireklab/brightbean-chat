#: templates/channels/list.html:106
msgid "Disconnect"
msgstr "Ажыратуу"

#: templates/channels/list.html:112
msgid "No channels connected yet"
msgstr "Азырынча туташтырылган каналдар жок"

#: templates/channels/list.html:114
msgid "Connect the first one and messages start arriving in your inbox."
msgstr "Биринчисин туташтырыңыз — билдирүүлөр кирген катка келе баштайт."

#: templates/channels/list.html:128
