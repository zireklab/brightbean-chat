#: apps/members/services.py:143
#, python-format
msgid "You cannot %(verb)s a member whose role is higher than your own."
msgstr "Ролу өзүңүздүкүнөн жогору мүчөнү %(verb)s албайсыз."

#: apps/members/services.py:145
#, python-format
msgid "Only organization owners can %(verb)s an organization admin."
msgstr "Уюм администраторун %(verb)s түзүн уюмдун ээлери гана иштете алат."

#: apps/members/services.py:158
msgid "That workspace does not belong to your organization."
msgstr "Бул мейкиндик сиздин уюмуңузга таандык эмес."

#: apps/members/services.py:160
#, python-format
msgid "Unknown workspace role: %(role)r."
msgstr "Мейкиндикте белгисиз роль: %(role)r."

#: apps/members/services.py:169
msgid "You cannot manage members in that workspace."
msgstr "Бул мейкиндикте мүчөлөрдү башкара албайсыз."

#: apps/members/services.py:171
msgid ""
"You cannot grant a workspace role higher than your own in that workspace."
msgstr "Бул мейкиндикте өзүңүздүн ролуңуздан жогору роль бере албайсыз."

#: apps/members/services.py:187
msgid ""
"Cannot remove the last admin of a workspace. Promote someone else first."
msgstr ""
"Мейкиндиктин акыркы администраторун өчүрүүгө болбойт. Адегенде башкасын "
"дайындаңыз."

#: apps/members/services.py:207
msgid "An email address is required."
msgstr "Email дареги керек."

#: apps/members/services.py:214
msgid "This person is already a member of your organization."
msgstr "Бул адам мурунтан эле уюмуңуздун мүчөсү."

#: apps/members/services.py:218
msgid ""
"An invitation is already pending for this address. You can resend it "
"instead."
msgstr "Бул дарекке чакыруу мурунтан эле жөнөтүлгөн. Аны кайра жөнөтө аласыз."

#: apps/members/services.py:221
msgid "Cannot invite someone as an organization owner."
msgstr "Кимдир бирөөнү уюм ээси катары чакырууга болбойт."

#: apps/members/services.py:225 apps/members/services.py:482
#, python-format
msgid "Unknown org role: %(role)r."
msgstr "Уюмда белгисиз роль: %(role)r."

#: apps/members/services.py:230
msgid "Only organization owners can invite someone as an admin."
msgstr "Администратор катары чакырууну уюм ээлери гана иштете алат."

#: apps/members/services.py:238
msgid "Choose at least one workspace to invite this person into."
msgstr "Бул адамды чакыруу үчүн кеминде бир мейкиндикти тандаңыз."

#: apps/members/services.py:288
msgid "This invitation is no longer available."
msgstr "Бул чакыруу мындан ары жеткиликсиз."

#: apps/members/services.py:292
msgid "This invitation has already been accepted."
msgstr "Бул чакыруу мурунтан эле кабыл алынган."

#: apps/members/services.py:294
msgid "This invitation has expired."
msgstr "Чакыруунун мөөнөтү бүттү."

#: apps/members/services.py:296
msgid "This invitation was sent to a different email address."
msgstr "Бул чакыруу башка email дарегине жөнөтүлгөн."

#: apps/members/services.py:313
#, python-format
msgid ""
"This account already belongs to %(org_name)s. BrightBean Chat supports one "
"organization per account, so leave that one first or accept this invitation "
"from a different account."
msgstr ""
"Бул аккаунт мурунтан эле %(org_name)s уюмуна таандык. BrightBean Chat бир "
"аккаунтка бир уюмду гана колдойт — адегенде андан чыгыңыз же бул чакырууну "
"башка аккаунттан кабыл алыңыз."

#: apps/members/services.py:377
msgid "Cannot resend an already accepted invitation."
msgstr "Мурунтан эле кабыл алынган чакырууну кайра жөнөтүүгө болбойт."

#: apps/members/services.py:388
msgid "Cannot revoke an already accepted invitation."
msgstr "Мурунтан эле кабыл алынган чакырууну жокко чыгарууга болбойт."

#: apps/members/services.py:420
#, python-format
msgid "You have been invited to %(org_name)s on BrightBean Chat"
msgstr "Сиз BrightBean Chat'та %(org_name)s уюмуна чакырылдыңыз"

#: apps/members/services.py:443
msgid "You cannot remove yourself from the organization."
msgstr "Өзүңүздү уюмдан чыгара албайсыз."

#: apps/members/services.py:455
msgid "Cannot remove the last organization owner."
msgstr "Уюмдун акыркы ээсин өчүрүүгө болбойт."

#: apps/members/services.py:457
msgid "remove"
msgstr "чыгаруу"

#: apps/members/services.py:478
msgid "Cannot promote to owner. Transfer ownership instead."
msgstr "Ээликке чейин көтөрүүгө болбойт. Анын ордуна ээликти өткөрүп бериңиз."

#: apps/members/services.py:486
msgid "change"
msgstr "өзгөртүү"

#: apps/members/services.py:488
msgid "Only organization owners can promote someone to admin."
msgstr "Администратор кылып көтөрүүнү уюм ээлери гана иштете алат."

#: apps/members/services.py:493
msgid "Cannot change the role of the last organization owner."
msgstr "Уюмдун акыркы ээсинин ролун өзгөртүүгө болбойт."

#: apps/members/services.py:534
msgid ""
"You cannot modify a workspace membership whose role is higher than your own."
msgstr "Ролу өзүңүздүкүнөн жогору мейкиндик мүчөлүгүн өзгөртө албайсыз."

#: apps/members/views.py:133
msgid "Invitation sent."
msgstr "Чакыруу жөнөтүлдү."

#: apps/members/views.py:147
msgid "Invitation resent."
msgstr "Чакыруу кайра жөнөтүлдү."

#: apps/members/views.py:161
msgid "Invitation revoked."
msgstr "Чакыруу жокко чыгарылды."

#: apps/members/views.py:175
msgid "Role updated."
msgstr "Роль жаңырды."

#: apps/members/views.py:189
msgid "Member removed."
msgstr "Мүчө чыгарылды."

#: apps/members/views.py:218
msgid "Workspace access updated."
msgstr "Мейкиндикке мүмкүнчүлүк жаңырды."

#: apps/members/views.py:275
#, python-format
msgid "You have joined %(name)s."
msgstr "Сиз %(name)s кошулдуңуз."

#: apps/notifications/events.py:225
#, python-brace-format
msgid "Flow \"{flow_name}\" hit the loop cap"
msgstr "«{flow_name}» сценарийи циклдер чегине жетти"

#: apps/notifications/events.py:227
#, python-brace-format
msgid ""
"It ran 30 blocks without pausing for {contact_name} and was stopped. Open "
"the flow and look for a cycle with no wait in it."
msgstr ""
"Ал {contact_name} үчүн 30 блокту тыныгуусуз аткарып, токтотулду. Сценарийди "
