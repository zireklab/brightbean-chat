#: templates/channels/email_connect.html:96
#: templates/channels/email_connect.html:97
msgid "port"
msgstr "порт"

#: templates/channels/email_connect.html:100
msgid "Choose \"none\" only for a relay on your own private network."
msgstr "«none» дегенди жеке тармагыңыздагы релей үчүн гана тандаңыз."

#: templates/channels/email_connect.html:103
msgid "Username"
msgstr "Колдонуучунун аты"

#: templates/channels/email_connect.html:107
