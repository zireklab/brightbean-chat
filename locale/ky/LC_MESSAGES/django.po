#: apps/api/events.py:94
msgid "Contact created"
msgstr "Байланыш түзүлдү"

#: apps/api/events.py:95
msgid "Tag added to a contact"
msgstr "Байланышка тег кошулду"

#: apps/api/events.py:96
msgid "Inbound message received"
msgstr "Кирүүчү билдирүү алынды"

#: apps/api/events.py:97
msgid "Flow execution completed"
msgstr "Сценарийдин аткарылышы аяктады"

#: apps/api/events.py:98
msgid "Contact subscribed to a sequence"
msgstr "Байланыш ырааттуулукка жазылды"

#: apps/api/events.py:99
msgid "Contact unsubscribed from a sequence"
msgstr "Байланыш ырааттуулуктан чыгарылды"

#: apps/api/events.py:100
msgid "Broadcast finished"
msgstr "Жайылтуу аяктады"

#: apps/api/models.py:75 templates/inbox/_thread_body.html:149
msgid "Read"
msgstr "Окуу"

#: apps/api/models.py:76
msgid "Write"
msgstr "Жазуу"

#: apps/api/models.py:77
msgid "Erase"
msgstr "Өчүрүү"

#: apps/api/models.py:88
msgid "Succeeded"
msgstr "Ийгиликтүү"

#: apps/api/models.py:89 templates/inbox/_thread_body.html:152
msgid "Failed"
msgstr "Ката"

#: apps/api/models.py:90
msgid "Blocked"
msgstr "Бөгөттөлдү"

#: apps/api/services.py:72
msgid "Only an organization owner or admin can issue API keys."
msgstr "API ачкычтарын уюмдун ээси же администратору гана чыгара алат."

#: apps/api/services.py:76
msgid ""
"You need the manage_api_keys permission in that workspace to issue a key for"
" it."
msgstr "Бул мейкиндикте ачкыч чыгаруу үчүн manage_api_keys уруксаты керек."

#: apps/api/services.py:82
msgid "A key needs at least one scope."
msgstr "Ачкычка кеминде бир мүмкүнчүлүк чөйрөсү керек."

#: apps/api/services.py:85
#, python-format
msgid "Unknown scope: %(scopes)s."
msgstr "Белгисиз мүмкүнчүлүк чөйрөсү: %(scopes)s."

#: apps/api/services.py:92
#, python-format
msgid ""
"You cannot grant the %(scope)s scope: it includes %(missing)s, which you do "
"not hold."
msgstr ""
"%(scope)s чөйрөсүн бере албайсыз: анда сизде жок %(missing)s камтылган."

#: apps/api/services.py:124
msgid "Give the key a name so you can recognise it later."
msgstr "Кийин таанып билүү үчүн ачкычка ат бериңиз."

#: apps/api/services.py:126
msgid "The name is too long (100 characters maximum)."
msgstr "Аты өтө узун (эң көбү 100 белги)."

#: apps/api/services.py:148
#, python-format
msgid ""
"This workspace already has %(limit)s active keys. Revoke one before issuing "
"another."
msgstr ""
"Бул мейкиндикте азырынча %(limit)s активдүү ачкыч бар. Жаңысын чыгаруудан "
"мурун бирин жокко чыгарыңыз."

#: apps/api/services.py:189
#, python-format
msgid "Unknown event: %(events)s."
msgstr "Белгисиз окуя: %(events)s."

#: apps/api/services.py:191
msgid "Choose at least one event to send."
msgstr "Жөнөтүү үчүн кеминде бир окуяны тандаңыз."

#: apps/api/services.py:207
msgid "Enter the URL deliveries should be sent to."
msgstr "Жеткирүүлөр жөнөтүлүүчү URL дарегин көрсөтүңүз."

#: apps/api/services.py:209
msgid "That URL is too long (500 characters maximum)."
msgstr "Бул URL өтө узун (эң көбү 500 белги)."

#: apps/api/services.py:212
msgid "The URL must start with http:// or https://."
msgstr "URL http:// же https:// менен башталышы керек."

#: apps/api/services.py:216
msgid "The URL must not carry a username or password."
msgstr "URL колдонуучунун атын же сырсөзүн камтыбашы керек."

#: apps/api/services.py:218 apps/api/services.py:222
msgid "That does not look like a valid URL."
msgstr "Бул туура URL сыяктуу эмес."

#: apps/api/services.py:249
#, python-format
msgid "This workspace already has %(limit)s endpoints."
msgstr "Бул мейкиндикте азырынча %(limit)s эндпоинт бар."

#: apps/api/views_keys.py:140
msgid "Choose a workspace."
msgstr "Мейкиндикти тандаңыз."

#: apps/api/views_keys.py:182
#, python-format
msgid "Revoked “%(name)s”."
msgstr "«%(name)s» жокко чыгарылды."

#: apps/api/views_keys.py:184
#, python-format
msgid "“%(name)s” was already revoked."
msgstr "«%(name)s» мурунтан эле жокко чыгарылган."

#: apps/api/views_webhooks.py:115
msgid "Endpoint created"
msgstr "Эндпоинт түзүлдү"

#: apps/api/views_webhooks.py:166
msgid "Endpoint updated."
msgstr "Эндпоинт жаңырды."

#: apps/api/views_webhooks.py:189
msgid "New signing secret"
msgstr "Жаңы кол коюу сыры"

#: apps/api/views_webhooks.py:207
#, python-format
msgid "Test delivered — the endpoint answered %(code)s."
msgstr "Тест жеткирилди — эндпоинт %(code)s менен жооп берди."

#: apps/api/views_webhooks.py:210
#, python-format
msgid "Test failed: %(reason)s."
msgstr "Тест ишке ашкан жок: %(reason)s."

#: apps/api/views_webhooks.py:222
#, python-format
msgid "Deleted %(url)s."
msgstr "%(url)s өчүрүлдү."

#: apps/billing/entitlements.py:345
#, python-format
msgid ""
"Your plan connects %(limit)s channels. Upgrade to connect more, or disable "
"one you are not using."
msgstr ""
"Тарифиңиз %(limit)s каналды туташтырууга уруксат берет. Дагы кошуу үчүн "
"тарифти жогорулатыңыз же колдонулбаган каналды өчүрүңүз."

#: apps/billing/entitlements.py:357
#, python-format
msgid ""
"Your plan runs %(limit)s automations at once. Upgrade, or switch one off to "
"free up a slot."
msgstr ""
"Тарифиңиз бир учурда %(limit)s автоматташтырууну иштетет. Тарифти "
"жогорулатыңыз же бирин өчүрүп орун бошотуңуз."

#: apps/billing/entitlements.py:370
#, python-format
msgid "Your plan includes %(limit)s user. Upgrade to add more."
msgid_plural "Your plan includes %(limit)s users. Upgrade to add more."
msgstr[0] ""
"Тарифиңизге %(limit)s колдонуучу кирет. Дагы кошуу үчүн тарифти "
"жогорулатыңыз."

#: apps/billing/entitlements.py:386
#, python-format
msgid "Your plan includes %(limit)s workspace. Upgrade to add more."
msgid_plural "Your plan includes %(limit)s workspaces. Upgrade to add more."
msgstr[0] ""
"Тарифиңизге %(limit)s мейкиндик кирет. Дагы кошуу үчүн тарифти "
"жогорулатыңыз."

#: apps/billing/entitlements.py:406
msgid "The public API is available on the paid plan."
msgstr "Ачык API акылуу тарифте жеткиликтүү."

#: apps/billing/services.py:53
msgid "Choose a monthly or yearly plan."
msgstr "Айлык же жылдык тарифти тандаңыз."

#: apps/billing/services.py:59
msgid "That plan is not available right now."
msgstr "Бул тариф азыр жеткиликсиз."

#: apps/billing/services.py:104 apps/billing/services.py:207
#: apps/billing/views.py:92
msgid "We could not start checkout. Try again in a minute."
msgstr ""
"Төлөмдү баштоо мүмкүн болгон жок. Бир мүнөттөн кийин кайра аракет кылыңыз."

#: apps/billing/services.py:129 apps/billing/services.py:145
msgid "A checkout is already open. Finish it, or wait a minute and try again."
msgstr ""
"Төлөм терезеси мурунтан ачык. Аны бүтүрүңүз же бир мүнөт күтүп кайра аракет "
"кылыңыз."

#: apps/billing/services.py:173
msgid "There is no billing account to manage yet."
msgstr "Азырынча башкарууга биллинг аккаунту жок."

#: apps/billing/views.py:75
msgid "You are already on the paid plan."
msgstr "Сиз мурунтан эле акылуу тарифтесиз."

#: apps/billing/views.py:118
msgid "We could not open the billing portal. Try again in a minute."
msgstr ""
"Төлөм порталын ачуу мүмкүн болгон жок. Бир мүнөттөн кийин кайра аракет "
"кылыңыз."

#: apps/broadcasts/notifications.py:40 apps/notifications/events.py:319
#, python-brace-format
msgid "Broadcast \"{broadcast_name}\" finished"
msgstr "«{broadcast_name}» жайылтуусу аяктады"

#: apps/broadcasts/notifications.py:41 apps/notifications/events.py:320
#, python-brace-format
msgid "{sent} sent, {failed} failed, {skipped} skipped."
msgstr "Жөнөтүлдү: {sent}, ката: {failed}, өткөрүп жиберилди: {skipped}."

#: apps/channels/forms.py:27
msgid ""
"That account is already connected to this deployment. Disconnect it there "
"first."
msgstr ""
"Бул аккаунт бул өнөктүккө мурунтан эле туташтырылган. Адегенде аны ошол "
"жерден ажыратыңыз."

#: apps/channels/forms.py:32
#, python-brace-format
msgid ""
"{label} has a guided setup that collects its credentials. Use that instead "
"of this form."
msgstr ""
"{label} үчүн эсептик маалыматтарды жыйноочу кадам-кадам жөндөө бар. Бул "
"форманын ордуна ошону колдонуңуз."

#: apps/channels/forms.py:47 templates/accounts/settings.html:32
#: templates/api/keys_list.html:39
#: templates/channels/whatsapp_templates.html:26
#: templates/inbox/_label_rows.html:46 templates/inbox/_rule_form.html:24
#: templates/organizations/settings.html:27
#: templates/organizations/settings.html:49
#: templates/workspaces/settings.html:36
msgid "Name"
msgstr "Аты"

#: apps/channels/forms.py:48 templates/channels/detail.html:40
msgid "Account identifier"
msgstr "Аккаунттун идентификатору"

#: apps/channels/forms.py:51
msgid "How this channel appears in the inbox and the flow builder."
msgstr "Бул канал кирген катта жана сценарий түзгүчтө кандай көрүнөт."

#: apps/channels/forms.py:53
msgid ""
"The platform's own id for the account: bot id, page id, phone number id, or "
"sending domain."
msgstr ""
"Аккаунт үчүн платформанын өз идентификатору: бот id, барак id, телефон "
"номеринин id же жөнөтүү домени."

#: apps/channels/forms_whatsapp.py:60
msgid "WhatsApp Business Account ID"
msgstr "WhatsApp Business аккаунтунун ID'си"

#: apps/channels/forms_whatsapp.py:62
msgid "From Business Manager → WhatsApp Accounts. Digits only."
msgstr "Business Manager → WhatsApp Accounts бөлүмүнөн. Сандар гана."

#: apps/channels/forms_whatsapp.py:65
msgid "Phone number ID"
msgstr "Телефон номеринин ID'си"

#: apps/channels/forms_whatsapp.py:67
msgid "The API id of the number, not the number itself."
msgstr "Номердин өзү эмес, номердин API идентификатору."

#: apps/channels/forms_whatsapp.py:70
msgid "Permanent access token"
msgstr "Туруктуу мүмкүнчүлүк токени"

#: apps/channels/forms_whatsapp.py:74
msgid ""
"A system user token with whatsapp_business_messaging and "
"whatsapp_business_management."
msgstr ""
"whatsapp_business_messaging жана whatsapp_business_management укуктары бар "
"системалык колдонуучунун токени."

#: apps/channels/forms_whatsapp.py:86
msgid "This is a numeric id from Business Manager."
msgstr "Бул Business Manager'ден алынган сандык идентификатор."

#: apps/channels/forms_whatsapp.py:92
msgid "Paste the system user token."
msgstr "Системалык колдонуучунун токенин чаптаңыз."

#: apps/channels/forms_whatsapp.py:107
msgid "Header"
msgstr "Аталышы"

#: apps/channels/forms_whatsapp.py:110
#, python-format
msgid "Optional, up to %(max)s characters. May contain {{1}}."
msgstr "Милдеттүү эмес, %(max)s белгиге чейин. {{1}} камтышы мүмкүн."

#: apps/channels/forms_whatsapp.py:113
msgid "Body"
msgstr "Дене бөлүгү"

#: apps/channels/forms_whatsapp.py:116
#, python-format
msgid "Up to %(max)s characters. Use {{1}}, {{2}} … for variables."
msgstr "%(max)s белгиге чейин. Өзгөрмөлөр үчүн {{1}}, {{2}} ж.б. колдонуңуз."

#: apps/channels/forms_whatsapp.py:119
msgid "Footer"
msgstr "Төмөнкү бөлүк"

#: apps/channels/forms_whatsapp.py:122
#, python-format
msgid "Optional, up to %(max)s characters. No variables allowed here."
msgstr ""
"Милдеттүү эмес, %(max)s белгиге чейин. Бул жерде өзгөрмөлөргө уруксат жок."

#: apps/channels/forms_whatsapp.py:124
msgid "Link button label"
msgstr "Шилтеме баскычынын тексти"

#: apps/channels/forms_whatsapp.py:126
msgid "Link button URL"
msgstr "Шилтеме баскычынын URL'и"

#: apps/channels/forms_whatsapp.py:129
msgid "May end in a variable, e.g. https://example.com/orders/{{1}}."
msgstr "Өзгөрмө менен аяктаса болот, мисалы https://example.com/orders/{{1}}."

#: apps/channels/forms_whatsapp.py:135
msgid "WhatsApp number"
msgstr "WhatsApp номери"

#: apps/channels/forms_whatsapp.py:135
msgid "Template name"
msgstr "Шаблондун аты"

#: apps/channels/forms_whatsapp.py:137
msgid ""
"Lowercase letters, digits and underscores. Meta shows this name in its "
"review queue."
msgstr ""
"Кичине тамгалар, сандар жана астыңкы сызыкчалар. Meta бул атты өзүнүн "
"текшерүү кезегинде көрсөтөт."

#: apps/channels/forms_whatsapp.py:138
msgid "Meta's language code, e.g. en_US."
msgstr "Meta'нын тил коду, мисалы en_US."

#: apps/channels/forms_whatsapp.py:160
#, python-format
msgid "Quick reply %(number)s"
msgstr "Тез жооп %(number)s"

#: apps/channels/forms_whatsapp.py:203
msgid "A footer cannot contain variables. Move it into the body."
msgstr ""
"Төмөнкү бөлүк өзгөрмөлөрдү камтый албайт. Аларды дене бөлүгүнө которуңуз."

#: apps/channels/forms_whatsapp.py:211
msgid "Use lowercase letters, digits and underscores only."
msgstr ""
"Кичине тамгаларды, сандарды жана астыңкы сызыкчаларды гана колдонуңуз."

#: apps/channels/forms_whatsapp.py:222
msgid "A link button needs both a label and a URL."
msgstr "Шилтеме баскычы үчүн тексти да, URL'и да керек."

#: apps/channels/forms_whatsapp.py:270
msgid "Marketing, per message"
msgstr "Маркетинг, ар бир билдирүү үчүн"

#: apps/channels/forms_whatsapp.py:271
msgid "Utility, per message"
msgstr "Тейлөө, ар бир билдирүү үчүн"

#: apps/channels/forms_whatsapp.py:272
msgid "Authentication, per message"
msgstr "Аутентификация, ар бир билдирүү үчүн"

#: apps/channels/forms_whatsapp.py:278
msgid "Use a three-letter ISO 4217 code, e.g. USD."
msgstr "ISO 4217 боюнча үч тамгалуу кодду колдонуңуз, мисалы USD."

#: apps/channels/forms_whatsapp.py:286
msgid "A price cannot be negative."
msgstr "Баа терс сан боло албайт."

#: apps/channels/models.py:103 templates/api/keys_list.html:87
msgid "Active"
msgstr "Активдүү"

#: apps/channels/models.py:104
msgid "Needs reconnection"
msgstr "Кайра туташуу керек"

#: apps/channels/models.py:105 templates/api/webhooks_list.html:65
#: templates/inbox/_rule_rows.html:38
msgid "Disabled"
msgstr "Өчүрүлгөн"

#: apps/channels/models.py:552
msgid "Marketing"
msgstr "Маркетинг"

#: apps/channels/models.py:553
msgid "Utility"
msgstr "Тейлөө"

#: apps/channels/models.py:554
msgid "Authentication"
msgstr "Аутентификация"

#: apps/channels/models.py:566
msgid "Draft"
msgstr "Долбоор"

#: apps/channels/models.py:567
msgid "In review"
msgstr "Текшерилүүдө"

#: apps/channels/models.py:568
msgid "Approved"
msgstr "Бекитилди"

#: apps/channels/models.py:569
msgid "Rejected"
msgstr "Четке кагылды"

#: apps/channels/views.py:402
msgid "That is not a status you can set by hand."
msgstr "Мындай статусту кол менен коюуга болбойт."

#: apps/channels/views.py:416
#, python-format
msgid "%(name)s is now %(status)s."
msgstr "%(name)s эми %(status)s."

#: apps/channels/views.py:461
#, python-format
msgid "Disconnected %(name)s."
msgstr "%(name)s ажыратылды."

#: apps/channels/views_email.py:89
msgid ""
"The mail server did not accept those details. Check the host, port, "
"encryption and sign-in details with your provider and try again."
msgstr ""
"Почта сервери бул маалыматтарды кабыл алган жок. Провайдериңизден хостту, "
"портту, шифрлөө түрүн жана кирүү маалыматтарын текшерип, кайра аракет "
"кылыңыз."

#: apps/channels/views_email.py:92
msgid ""
"Resend did not accept that API key. Copy it again from the Resend dashboard "
"and try again."
msgstr ""
"Resend бул API ачкычын кабыл алган жок. Аны Resend панелинен кайра көчүрүп, "
"дагы аракет кылыңыз."

#: apps/channels/views_email.py:94
msgid ""
"AWS did not accept those credentials. Check the access key, secret and "
"region, and that the key is allowed to use SES."
msgstr ""
"AWS бул эсептик маалыматтарды кабыл алган жок. Access key, secret жана "
"региондун туура экенин, ошондой эле ачкычка SES колдонууга уруксат "
"берилгенин текшериңиз."

#: apps/channels/views_email.py:215
#, python-format
msgid "Connected %(domain)s."
msgstr "%(domain)s туташтырылды."

#: apps/channels/views_email.py:229
msgid "Paste the API key from your Resend dashboard."
msgstr "Resend панелинен API ачкычын чаптаңыз."

#: apps/channels/views_email.py:239
msgid "Enter the access key, the secret and the AWS region."
msgstr "Access key, secret жана AWS регионун киргизиңиз."

#: apps/channels/views_email.py:241
msgid ""
"That is not an AWS region name. It looks like eu-west-1 or us-gov-east-1."
msgstr ""
"Бул AWS регионунун аты сыяктуу эмес. Ал eu-west-1 же us-gov-east-1 сыяктуу "
"көрүнүшү керек."

#: apps/channels/views_email.py:256
msgid "Enter the SMTP host your provider gave you."
msgstr "Провайдериңиз берген SMTP хостун киргизиңиз."

#: apps/channels/views_email.py:259
msgid "The SMTP port is a number — usually 587 for STARTTLS or 465 for SSL."
msgstr "SMTP порту — сан, адатта STARTTLS үчүн 587 же SSL үчүн 465."

#: apps/channels/views_email.py:262
msgid "Choose STARTTLS, SSL or none for the connection encryption."
msgstr "Байланышты шифрлөө үчүн STARTTLS, SSL же эч нерсе тандаңыз."

#: apps/channels/views_email.py:314
msgid "Updated this channel's webhook settings."
msgstr "Бул каналдын webhook жөндөөлөрү жаңыртылды."

#: apps/channels/views_email.py:316
msgid "Nothing to update."
msgstr "Жаңыртуучу эч нерсе жок."

#: apps/channels/views_email.py:344
msgid "Your account has no email address to send a test to."
msgstr "Аккаунтуңузда сыноо катын жөнөтө турган электрондук почта дареги жок."

#: apps/channels/views_email.py:354
msgid "Too many test emails for this channel just now. Try again shortly."
msgstr ""
