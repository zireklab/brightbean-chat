#: apps/notifications/events.py:211
#, python-brace-format
msgid "Flow \"{flow_name}\" hit the loop cap"
msgstr "«{flow_name}» сценарийи циклдер чегине жетти"

#: apps/notifications/events.py:213
#, python-brace-format
msgid ""
"It ran 30 blocks without pausing for {contact_name} and was stopped. Open "
"the flow and look for a cycle with no wait in it."
msgstr ""
"Ал {contact_name} үчүн 30 блокту тыныгуусуз аткарып, токтотулду. Сценарийди "
"ачып, күтүүсүз циклди табыңыз."

